{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evals/schema/inferential-report.schema.json",
  "title": "Inferential evaluation · report",
  "description": "What `scripts/evals.py inferential --json <file>` writes. A group that could not run (no model configured) is `skipped`, with the reason: skipped is never green.",
  "type": "object",
  "required": ["schemaVersion", "date", "green", "reds", "groups", "byLang", "results"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "command": {"type": "array", "items": {"type": "string"}},
    "langFilter": {"type": "array", "items": {"enum": ["en", "es"]}},
    "green": {"type": "boolean"},
    "reds": {"type": "array", "items": {"type": "string"}},
    "groups": {
      "type": "object",
      "required": ["reviewer", "agent"],
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "oneOf": [
            {"$ref": "#/$defs/skipped"},
            {
              "type": "object",
              "required": ["status", "cases", "tp", "fp", "fn", "tn", "noVerdict", "recall", "precision"],
              "additionalProperties": false,
              "properties": {
                "status": {"const": "ran"},
                "cases": {"type": "integer", "minimum": 0},
                "tp": {"type": "integer", "minimum": 0},
                "fp": {"type": "integer", "minimum": 0},
                "fn": {"type": "integer", "minimum": 0},
                "tn": {"type": "integer", "minimum": 0},
                "noVerdict": {"type": "integer", "minimum": 0},
                "recall": {"$ref": "#/$defs/rate"},
                "precision": {"$ref": "#/$defs/rate"}
              }
            }
          ]
        },
        "agent": {
          "oneOf": [
            {"$ref": "#/$defs/skipped"},
            {
              "type": "object",
              "required": ["status", "cases", "compliant", "compliance", "tampered", "repeatedBrakes"],
              "additionalProperties": false,
              "properties": {
                "status": {"const": "ran"},
                "cases": {"type": "integer", "minimum": 0},
                "compliant": {"type": "integer", "minimum": 0},
                "compliance": {"$ref": "#/$defs/rate"},
                "tampered": {"type": "integer", "minimum": 0},
                "repeatedBrakes": {"type": "integer", "minimum": 0}
              }
            }
          ]
        }
      }
    },
    "byLang": {
      "type": "object",
      "propertyNames": {"enum": ["en", "es"]},
      "additionalProperties": {
        "type": "object",
        "required": ["cases", "hits"],
        "additionalProperties": false,
        "properties": {"cases": {"type": "integer", "minimum": 0}, "hits": {"type": "integer", "minimum": 0}}
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "group", "lang", "hit"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "group": {"enum": ["reviewer", "agent"]},
          "lang": {"enum": ["en", "es"]},
          "case": {"type": "string"},
          "expected": {"type": "string"},
          "did": {"type": "string"},
          "hit": {"type": "boolean"},
          "result": {"type": "string"},
          "tampered": {"type": "boolean"},
          "brakes": {"type": "array", "items": {"type": "string"}},
          "repeats": {"type": "integer", "minimum": 0},
          "detail": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "skipped": {
      "type": "object",
      "required": ["status", "reason"],
      "additionalProperties": false,
      "properties": {"status": {"const": "skipped"}, "reason": {"type": "string", "minLength": 3}}
    }
  }
}
