{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evals/schema/inferential-suite.schema.json",
  "title": "Inferential evaluation · suite",
  "description": "What a model judges, measured as a rate against labeled cases. `reviewer`: a model reviews a diff against its task. `agent`: a model works a replicable case inside the loop. Each group runs only when its `requiresEnv` variable is set (a model is configured); otherwise it is SKIPPED, never green.",
  "type": "object",
  "required": ["version", "groups", "caseFiles"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "$comment": {"type": "string"},
    "version": {"const": 1},
    "groups": {
      "type": "object",
      "required": ["reviewer", "agent"],
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "type": "object",
          "required": ["requiresEnv", "command", "timeoutSeconds", "thresholds", "prompts", "verdict"],
          "additionalProperties": false,
          "properties": {
            "$comment": {"type": "string"},
            "requiresEnv": {"$ref": "#/$defs/envName"},
            "command": {"$ref": "#/$defs/command"},
            "timeoutSeconds": {"type": "integer", "minimum": 1},
            "thresholds": {
              "type": "object",
              "required": ["minRecall", "minPrecision"],
              "additionalProperties": false,
              "properties": {"minRecall": {"$ref": "#/$defs/rate"}, "minPrecision": {"$ref": "#/$defs/rate"}}
            },
            "prompts": {
              "type": "object",
              "required": ["en", "es"],
              "additionalProperties": false,
              "properties": {"en": {"$ref": "#/$defs/prompt"}, "es": {"$ref": "#/$defs/prompt"}},
              "description": "One prompt per case language. `{task}` and `{diff}` are replaced; the reviewer never sees the label."
            },
            "verdict": {
              "type": "object",
              "required": ["pattern", "approve", "reject"],
              "additionalProperties": false,
              "properties": {
                "pattern": {"type": "string", "minLength": 3, "description": "A regex whose first group is the verdict word. The LAST match of the output counts (`hermes chat -q` echoes the prompt first)."},
                "approve": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "reject": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          }
        },
        "agent": {
          "type": "object",
          "required": ["requiresEnv", "command", "timeoutMinutes", "thresholds"],
          "additionalProperties": false,
          "properties": {
            "$comment": {"type": "string"},
            "requiresEnv": {"$ref": "#/$defs/envName"},
            "command": {"$ref": "#/$defs/command"},
            "timeoutMinutes": {"type": "integer", "minimum": 1},
            "thresholds": {
              "type": "object",
              "required": ["minCompliance"],
              "additionalProperties": false,
              "properties": {"minCompliance": {"$ref": "#/$defs/rate"}}
            }
          }
        }
      }
    },
    "caseFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9/._-]+\\.json$"}
    }
  },
  "$defs": {
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "envName": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "argv without a shell; `{prompt}` is replaced inside each argument. `--command` overrides it."
    },
    "prompt": {"type": "string", "minLength": 20, "pattern": "\\{task\\}[\\s\\S]*\\{diff\\}"}
  }
}
