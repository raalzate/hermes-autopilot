{
  "id": "azure",
  "titulo": "Azure DevOps (`az` + extensión azure-devops)",
  "descripcion": "Repos, work items con relación Parent (el vínculo padre→hijo nativo), iteraciones como milestones, Azure Boards (viene con el proyecto: no se crea), wiki como repo git y Azure Pipelines. El repo se nombra `<org>/<proyecto>/<repo>`. Adaptador: probado por `workspace.py check` y en seco, no contra un Azure DevOps real.",
  "verificado": "2026-10-19 · az 2.x + azure-devops: `repos create`, `boards work-item create|show|update|relation add`, `boards iteration project create`.",
  "cli": "az",
  "integracion": "azure-devops",
  "issuePattern": "(AB)?#\\d+",
  "issueExample": "AB#12",
  "cierra": "Fixes AB#{n}",
  "cuerpoHijo": "Parte de {padre}",
  "wiki": "https://dev.azure.com/{owner}/{proyecto}/_git/{proyecto}.wiki",
  "wikiNota": "La wiki del proyecto se crea desde la web (Overview → Wiki → Create project wiki). La descripción de un work item es HTML: el checklist de la épica se guarda con un salto `<br>` por línea.",
  "defaults": {"tipo": "Issue"},
  "partesRepo": 3,
  "plantillaIssue": null,
  "ci": [
    {"de": "ci/azure-pipelines.yml", "a": "azure-pipelines.yml", "runner": "drift"}
  ],
  "ops": {
    "repo.crear": ["az", "repos", "create", "--name", "{nombre}", "--project", "{proyecto}", "--org", "https://dev.azure.com/{owner}"],
    "issue.crear": ["az", "boards", "work-item", "create", "--type", "{tipo}", "--title", "{titulo}", "--description", "{cuerpo}", "--project", "{proyecto}", "--org", "https://dev.azure.com/{owner}", ["--iteration", "{milestone}"], "--output", "json"],
    "issue.id": null,
    "issue.vincular": ["az", "boards", "work-item", "relation", "add", "--id", "{n}", "--relation-type", "parent", "--target-id", "{n_padre}", "--org", "https://dev.azure.com/{owner}"],
    "issue.estado": ["az", "boards", "work-item", "show", "--id", "{n}", "--org", "https://dev.azure.com/{owner}", "--query", "fields.\"System.State\"", "--output", "tsv"],
    "issue.cuerpo": ["az", "boards", "work-item", "show", "--id", "{n}", "--org", "https://dev.azure.com/{owner}", "--query", "fields.\"System.Description\"", "--output", "tsv"],
    "issue.editar": ["az", "boards", "work-item", "update", "--id", "{n}", "--description", "{cuerpo}", "--org", "https://dev.azure.com/{owner}"],
    "milestone.crear": ["az", "boards", "iteration", "project", "create", "--name", "{titulo}", "--project", "{proyecto}", "--org", "https://dev.azure.com/{owner}", ["--finish-date", "{fecha}"]],
    "tablero.crear": null,
    "tablero.agregar": null
  },
  "salida": {
    "issue.crear": {"json": "id"}
  },
  "saltoDeLinea": "<br>",
  "estados": {"New": "abierto", "To Do": "abierto", "Active": "abierto", "Doing": "abierto", "Resolved": "cerrado", "Done": "cerrado", "Closed": "cerrado"},
  "simulado": {
    "issue.crear": "{\"id\": {n}}",
    "issue.estado": "{crudo}",
    "issue.cuerpo": "{cuerpo}"
  },
  "clases": {
    "repo.crear": "write",
    "issue.crear": "send",
    "issue.vincular": "write",
    "issue.estado": "read",
    "issue.cuerpo": "read",
    "issue.editar": "write",
    "milestone.crear": "write"
  },
  "setup": [
    "az extension add --name azure-devops",
    "az login                       # una vez, fuera del agente"
  ],
  "examples": [
    {"op": "issue.crear", "vars": {"owner": "org", "proyecto": "plataforma", "titulo": "Login", "cuerpo": "Parte de org/plataforma/gestion#1", "tipo": "Issue"},
     "argv": ["az", "boards", "work-item", "create", "--type", "Issue", "--title", "Login", "--description", "Parte de org/plataforma/gestion#1", "--project", "plataforma", "--org", "https://dev.azure.com/org", "--output", "json"],
     "why": "el tipo sale de `defaults` (Issue en el proceso Basic; en Agile, `User Story`)"},
    {"op": "issue.vincular", "vars": {"n": "41", "n_padre": "40", "owner": "org"},
     "argv": ["az", "boards", "work-item", "relation", "add", "--id", "41", "--relation-type", "parent", "--target-id", "40", "--org", "https://dev.azure.com/org"],
     "why": "el hijo apunta a su Parent: la relación vive en el hijo"}
  ]
}
