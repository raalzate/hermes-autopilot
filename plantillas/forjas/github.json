{
  "id": "github",
  "titulo": "GitHub (`gh`)",
  "descripcion": "Repo, issues con sub-issues (el vínculo padre→hijo nativo), milestones, GitHub Projects como tablero, wiki como repo git aparte y GitHub Actions como pipeline.",
  "verificado": "2026-10-19 · gh 2.x: `issue create|view|edit`, `api` (sub_issues, milestones), `project create|item-add`, `repo create`",
  "cli": "gh",
  "integracion": "github",
  "issuePattern": "#\\d+",
  "issueExample": "#12",
  "cierra": "Closes #{n}",
  "cuerpoHijo": "Parte de {padre}",
  "wiki": "https://github.com/{repo}.wiki.git",
  "wikiNota": "GitHub crea el repo de la wiki con la primera página, desde la web (pestaña Wiki → Create the first page). Después, `workspace.py wiki --apply` la empuja.",
  "plantillaIssue": {"ruta": ".github/ISSUE_TEMPLATE/epica.md", "encabezado": "---\nname: Épica\nabout: Una épica del workspace, con su checklist de hijos\nlabels: epica\n---\n\n"},
  "ci": [
    {"de": "ci.yml", "a": ".github/workflows/harness.yml"},
    {"de": "drift.yml", "a": ".github/workflows/harness-drift.yml", "runner": "drift"}
  ],
  "ops": {
    "repo.crear": ["gh", "repo", "create", "{repo}", "--private", "--add-readme", ["--description", "{descripcion}"]],
    "issue.crear": ["gh", "issue", "create", "-R", "{repo}", "--title", "{titulo}", "--body", "{cuerpo}", ["--milestone", "{milestone}"], ["--label", "{etiqueta}"]],
    "issue.id": ["gh", "api", "repos/{repo}/issues/{n}", "--jq", ".id"],
    "issue.vincular": ["gh", "api", "repos/{repo_padre}/issues/{n_padre}/sub_issues", "-X", "POST", "-F", "sub_issue_id={id_hijo}"],
    "issue.estado": ["gh", "issue", "view", "{n}", "-R", "{repo}", "--json", "state", "--jq", ".state"],
    "issue.cuerpo": ["gh", "issue", "view", "{n}", "-R", "{repo}", "--json", "body", "--jq", ".body"],
    "issue.editar": ["gh", "issue", "edit", "{n}", "-R", "{repo}", "--body", "{cuerpo}"],
    "milestone.crear": ["gh", "api", "repos/{repo}/milestones", "-X", "POST", "-f", "title={titulo}", ["-f", "description={descripcion}"], ["-f", "due_on={fecha}"]],
    "tablero.crear": ["gh", "project", "create", "--owner", "{owner}", "--title", "{titulo}", "--format", "json"],
    "tablero.agregar": ["gh", "project", "item-add", "{tablero}", "--owner", "{owner}", "--url", "{url}"]
  },
  "salida": {
    "issue.crear": {"regex": "/issues/(\\d+)"},
    "tablero.crear": {"json": "number"}
  },
  "estados": {"OPEN": "abierto", "CLOSED": "cerrado"},
  "simulado": {
    "issue.crear": "https://github.com/{repo}/issues/{n}",
    "issue.id": "{id}",
    "issue.estado": "{crudo}",
    "issue.cuerpo": "{cuerpo}",
    "tablero.crear": "{\"number\": {n}}"
  },
  "clases": {
    "repo.crear": "write",
    "issue.crear": "send",
    "issue.id": "read",
    "issue.vincular": "write",
    "issue.estado": "read",
    "issue.cuerpo": "read",
    "issue.editar": "write",
    "milestone.crear": "write",
    "tablero.crear": "write",
    "tablero.agregar": "write"
  },
  "setup": [
    "gh auth login                  # una vez, fuera del agente",
    "gh auth refresh -s project     # el tablero (GitHub Projects) pide este scope"
  ],
  "examples": [
    {"op": "issue.crear", "vars": {"repo": "org/api", "titulo": "Login", "cuerpo": "Parte de org/gestion#1"},
     "argv": ["gh", "issue", "create", "-R", "org/api", "--title", "Login", "--body", "Parte de org/gestion#1"],
     "why": "sin milestone ni etiqueta, los grupos opcionales no entran"},
    {"op": "issue.crear", "vars": {"repo": "org/gestion", "titulo": "Épica", "cuerpo": "x", "milestone": "v1"},
     "argv": ["gh", "issue", "create", "-R", "org/gestion", "--title", "Épica", "--body", "x", "--milestone", "v1"],
     "why": "con milestone, el grupo entra entero"},
    {"op": "issue.vincular", "vars": {"repo_padre": "org/gestion", "n_padre": "1", "id_hijo": "900"},
     "argv": ["gh", "api", "repos/org/gestion/issues/1/sub_issues", "-X", "POST", "-F", "sub_issue_id=900"],
     "why": "el sub-issue se cuelga del padre por su id interno, no por su número"}
  ]
}
