  "classes": {
    "deny": "^(graph-batch|upload-my-profile-photo|remove-account)$",
    "destructive": "^delete-|^(clear-excel-range|cancel-calendar-event|move-mail-message|create-mail-rule|update-mail-rule|update-mailbox-settings|create-my-calendar-permission|update-my-calendar-permission)$",
    "send": "^(send-mail|send-draft-message|reply-mail-message|reply-all-mail-message|forward-mail-message|forward-calendar-event|share-drive-item|create-drive-item-share-link|create-planner-task-message)$",
    "read": "^(list|get|search|verify|parse)-|^download-bytes$"
  },
  "thirdParty": "^(list-mail-messages|list-mail-folder-messages|get-mail-message|list-mail-attachments|get-onenote-page-content|list-planner-task-messages|download-bytes)",
  "recipientKeys": "^(address|recipients|email)$",
  "fileKeys": "^(outputPath|filePath|path)$",
  "policy": {
    "allowRecipients": []
  },
  "budget": {
    "maxPerHour": {
      "send": 20,
      "destructive": 5
    },
    "maxResultChars": 40000,
    "idleMinutes": 10,
    "timeoutSeconds": 120,
    "maxMemoryMB": 512,
    "nice": 5
  },
  "perfiles": {
    "lectura": {
      "read": "allow",
      "write": "deny",
      "send": "deny",
      "destructive": "deny"
    },
    "asistente": {
      "read": "allow",
      "write": "ask",
      "send": "allowlist",
      "destructive": "deny"
    },
    "autonomo": {
      "read": "allow",
      "write": "allow",
      "send": "allowlist",
      "destructive": "ask"
    }
  },
  "perfilPorDefecto": "lectura",
  "reasons": {
    "deny": "`graph-batch` manda cualquier pedido a Graph: es una puerta que saltea la clase de cada herramienta.",
    "destructive": "una regla de correo puede reenviar todo afuera; borrar en Graph no tiene papelera para todo."
  },
  "requires": [
    {
      "kind": "system",
      "command": "node",
      "min": "20",
      "hint": {
        "darwin": "brew install node",
        "win32": "winget install OpenJS.NodeJS.LTS",
        "default": "instalá Node 20+"
      }
    },
    {
      "kind": "npm",
      "package": "@softeria/ms-365-mcp-server",
      "version": "0.160.0",
      "bin": "ms-365-mcp-server"
    }
  ],
  "launch": {
    "runtime": "node",
    "bin": {
      "kind": "npm",
      "name": "ms-365-mcp-server"
    },
    "args": [],
    "argsPorPerfil": {
      "lectura": [
        "--read-only"
      ]
    },
    "env": {
      "MS365_MCP_MESSAGE_SIGNOFF_SUFFIX": "\n\n[enviado por un agente]",
      "MS365_MCP_MAX_ITEMS": "50"
    }
  },
  "setup": [
    "Login una vez, fuera del agente: {prefix}/node_modules/.bin/ms-365-mcp-server --login",
    "Cuenta de trabajo: MS365_MCP_CLIENT_ID con el id de TU aplicación de Entra (no es un secreto)."
  ],
  "examples": [
    {
      "tool": "list-mail-messages",
      "args": {},
      "expect": "allow",
      "why": "listar correo es lectura"
    },
    {
      "tool": "graph-batch",
      "args": {
        "body": {}
      },
      "perfil": "autonomo",
      "expect": "block",
      "regla": "clase-deny",
      "why": "un batch de Graph saltea la clasificación"
    },
    {
      "tool": "send-mail",
      "args": {
        "body": {
          "message": {
            "toRecipients": [
              {
                "emailAddress": {
                  "address": "x@externo.test"
                }
              }
            ]
          }
        }
      },
      "perfil": "lectura",
      "expect": "block",
      "regla": "clase-send",
      "why": "lectura no manda"
    },
    {
      "tool": "send-mail",
      "args": {
        "body": {
          "message": {
            "toRecipients": [
              {
                "emailAddress": {
                  "address": "x@externo.test"
                }
              }
            ]
          }
        }
      },
      "perfil": "asistente",
      "set": {
        "policy.allowRecipients": [
          "@miempresa\\.test$"
        ]
      },
      "expect": "approve",
      "regla": "destinatario",
      "why": "Graph anida el destinatario: igual se ve"
    },
    {
      "tool": "send-mail",
      "args": {
        "body": {
          "message": {
            "toRecipients": [
              {
                "emailAddress": {
                  "address": "ana@miempresa.test"
                }
              }
            ]
          }
        }
      },
      "perfil": "asistente",
      "set": {
        "policy.allowRecipients": [
          "@miempresa\\.test$"
        ]
      },
      "expect": "allow",
      "why": "destinatario de la lista"
    },
    {
      "tool": "create-mail-rule",
      "args": {
        "body": {
          "actions": {
            "forwardTo": [
              {
                "emailAddress": {
                  "address": "x@externo.test"
                }
              }
            ]
          }
        }
      },
      "perfil": "asistente",
      "expect": "block",
      "regla": "clase-destructive",
      "why": "una regla que reenvía es una fuga permanente"
    },
    {
      "tool": "delete-mail-message",
      "args": {
        "messageId": "x"
      },
      "perfil": "autonomo",
      "expect": "approve",
      "regla": "pide-destructive",
      "why": "borrar lo aprueba un humano"
    }
  ]
}
